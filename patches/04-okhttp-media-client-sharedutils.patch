+    /**
+     * Streaming-optimized client builder for media (video/audio) downloads.<br/>
+     * <br/>
+     * Why HTTP/2: when SmartTube plays through a Cloudflare Workers/Pages proxy (e.g. edgetunnel),
+     * every new TCP connection may be served from a different CF edge/exit IP. Googlevideo then
+     * sees the same stream URL coming from many different IPs and starts throttling/resetting it,
+     * which looks like constant buffering (stalling) on the TV while phone/PC clients (HTTP/2/QUIC,
+     * multiplexed over one connection) play fine. Allowing HTTP/2 (with HTTP/1.1 fallback) lets
+     * ExoPlayer's parallel range/segment requests share a single long-lived connection to the
+     * proxy, keeping the exit IP stable. The long-lived connection pool makes subsequent Range
+     * requests reuse the same connection instead of hopping between egresses.
+     */
+    static OkHttpClient.Builder setupMediaBuilder(OkHttpClient.Builder okBuilder) {
+        okBuilder.connectTimeout(MEDIA_CONNECT_TIMEOUT_MS, TimeUnit.MILLISECONDS);
+        okBuilder.readTimeout(MEDIA_READ_TIMEOUT_MS, TimeUnit.MILLISECONDS);
+        okBuilder.writeTimeout(MEDIA_WRITE_TIMEOUT_MS, TimeUnit.MILLISECONDS);
+
+        // Keep connections alive long enough to cover an entire video.
+        okBuilder.connectionPool(new ConnectionPool(8, 30, TimeUnit.MINUTES));
+        okBuilder.retryOnConnectionFailure(true);
+
+        // HTTP/2 multiplexing over a single connection (fallback to HTTP/1.1).
+        okBuilder.protocols(Arrays.asList(Protocol.HTTP_2, Protocol.HTTP_1_1));
+
+        setupConnectionFix(okBuilder);
+        preferIPv4Dns(okBuilder);
+        configureToIgnoreCertificate(okBuilder);
+        enableDecompression(okBuilder);
+
+        return okBuilder;
+    }
+
 
